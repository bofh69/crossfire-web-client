{
  "name": "crossfire-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:singlefile": "vite build --config vite.singlefile.config.ts --mode singlefile-main && vite build --config vite.singlefile.config.ts --mode singlefile-replay",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "replay:playwright": "node scripts/replay-with-playwright.mjs",
    "recording:convert": "node scripts/convert-ws-recording-log.mjs",
    "test:mapdata": "vitest run tests/replay-mapdata/replay-mapdata.spec.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.12.0",
    "playwright": "^1.55.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.1",
    "svelte": "^5.53.12",
    "svelte-check": "^4.4.5",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.7",
    "ws": "^8.18.3"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/fira-mono": "^5.2.7",
    "@fontsource/modern-antiqua": "^5.2.8",
    "@fontsource/noto-sans-runic": "^5.2.6",
    "@fontsource/uncial-antiqua": "^5.2.7"
  }
}
